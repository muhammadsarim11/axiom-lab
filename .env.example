# Copy to .env.local and fill in once the client's details / domain are ready.

# Final live domain (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com.au

# Contact details shown on the About page / footer / form
NEXT_PUBLIC_PHONE_DISPLAY="+61 4XX XXX XXX"
# WhatsApp number: digits only, with country code, no + or spaces (e.g. 61412345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com.au

# Social profiles (full URLs)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Enquiry form email delivery via Resend (https://resend.com). Optional:
# without these the form falls back to opening WhatsApp with the enquiry pre-filled.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Axiom Tutoring <enquiries@yourdomain.com.au>"
